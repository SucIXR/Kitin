Subject: [PATCH] Network_ChunkLazyLoading


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 8dc428c5508ef6ebea772638db1a607fc914c7eb..24270bccbdab7b9a75fc9d929e55f2f7bbe96769 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -919,6 +919,13 @@ public final class RegionizedPlayerChunkLoader {
         }
 
         void update() {
+            // Kitin start - lazy chunk update gate (with init guard)
+            if (this.lastSendDistance != Integer.MIN_VALUE // 或者 lastChunkX != MIN_VALUE 也行
+                    && me.sucixr.kitin.network.misc.ChunkLoadPolicy.getInstance().shouldSkipChunkUpdate(this.player)
+                    && me.sucixr.kitin.config.KitinConfig.chunkLazyLoading) {
+                return;
+            }
+            // Kitin end
             TickThread.ensureTickThread(this.player, "Cannot update player asynchronously");
             if (this.removed) {
                 throw new IllegalStateException("Updating removed player chunk loader");
