Subject: [PATCH] Network_Multi-Port-Listening


diff --git a/net/minecraft/server/network/ServerConnectionListener.java b/net/minecraft/server/network/ServerConnectionListener.java
index e917afa054136967bca6e712237a8b3671ad5db2..db4993ee4b9f57438cb070267b21dc25b5ba24f4 100644
--- a/net/minecraft/server/network/ServerConnectionListener.java
+++ b/net/minecraft/server/network/ServerConnectionListener.java
@@ -69,11 +69,28 @@ public class ServerConnectionListener {
     }
 
     public void startTcpServerListener(SocketAddress address) throws IOException {
-        // Paper end - Unix domain socket support
+        // Kitin start - Multi-port listening
+        // 绑定主端口 (使用全局配置)
+        this.bind(address, io.papermc.paper.configuration.GlobalConfiguration.get().proxies.proxyProtocol);
+
+        // 绑定额外端口
+        for (me.sucixr.kitin.config.KitinConfig.ListenerConfig cfg : me.sucixr.kitin.config.KitinConfig.extraListeners) {
+            try {
+                LOGGER.info("[Kitin] Binding extra listener '{}' on {}:{} (ProxyProtocol: {})", 
+                    cfg.name, cfg.bindAddress, cfg.port, cfg.proxyProtocol);
+                this.bind(new java.net.InetSocketAddress(InetAddress.getByName(cfg.bindAddress), cfg.port), cfg.proxyProtocol);
+            } catch (Exception e) {
+                LOGGER.error("[Kitin] Failed to bind extra listener: " + cfg.name, e);
+            }
+        }
+    }
+
+    private void bind(SocketAddress address, boolean useProxyProtocol) throws IOException {
+        // Kitin end
         synchronized (this.channels) {
             EventLoopGroupHolder eventLoopGroupHolder = EventLoopGroupHolder.remote(address, this.server.useNativeTransport()); // Paper - Unix domain socket support
             // Paper start - Warn people with console access that HAProxy is in use.
-            if (io.papermc.paper.configuration.GlobalConfiguration.get().proxies.proxyProtocol) {
+            if (useProxyProtocol) { // Kitin - use parameter
                 LOGGER.warn("Using HAProxy, please ensure the server port is adequately firewalled.");
             }
             // Paper end - Warn people with console access that HAProxy is in use.
@@ -110,7 +127,7 @@ public class ServerConnectionListener {
                                         ? new RateKickingConnection(rateLimitPacketsPerSecond)
                                         : new Connection(PacketFlow.SERVERBOUND));
                                     // Paper start - Add support for Proxy Protocol
-                                    if (io.papermc.paper.configuration.GlobalConfiguration.get().proxies.proxyProtocol) {
+                                    if (useProxyProtocol) { // Kitin - use parameter
                                         channel.pipeline().addAfter(HandlerNames.TIMEOUT, "haproxy-decoder", new io.netty.handler.codec.haproxy.HAProxyMessageDecoder());
                                         channel.pipeline().addAfter("haproxy-decoder", "haproxy-handler", new ChannelInboundHandlerAdapter() {
                                             @Override
