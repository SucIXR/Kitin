From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SucIXR <sasasa123456@foxmail.com>
Date: Fri, 24 Jul 2026 12:59:00 +0800
Subject: [PATCH] FoliaFix_FishingHook


diff --git a/net/minecraft/world/entity/projectile/FishingHook.java b/net/minecraft/world/entity/projectile/FishingHook.java
index d7217fd075c6d6fae3622c56e940e247008dcc27..9e490c2688159138f0e1e1abe6d86a93fa92dbcb 100644
--- a/net/minecraft/world/entity/projectile/FishingHook.java
+++ b/net/minecraft/world/entity/projectile/FishingHook.java
@@ -66,6 +66,13 @@ public class FishingHook extends Projectile {
     private boolean openWater = true;
     private @Nullable Entity hookedIn;
     public FishingHook.FishHookState currentState = FishingHook.FishHookState.FLYING;
+
+    // Kitin start - FoliaFix_FishingHook
+    public static final java.util.Map<java.util.UUID, FishingHook> KITIN_GLOBAL_BOBBERS = new java.util.concurrent.ConcurrentHashMap<>();
+    public volatile boolean kitinForceDiscard = false;
+    public java.util.UUID kitinOwnerUUID = null;
+    // Kitin end
+
     private final int luck;
     private final int lureSpeed;
     private final InterpolationHandler interpolationHandler = new InterpolationHandler(this);
@@ -99,6 +106,18 @@ public class FishingHook extends Projectile {
     public FishingHook(final Player player, final Level level, final int luck, final int lureSpeed) {
         this(EntityTypes.FISHING_BOBBER, level, luck, lureSpeed);
         this.setOwner(player);
+        // Kitin start - FoliaFix_FishingHook
+        if (owner != null) {
+            FishingHook oldBobber = KITIN_GLOBAL_BOBBERS.get(owner.getUUID());
+            if (oldBobber != null && oldBobber != this && !oldBobber.isRemoved()) {
+                me.sucixr.kitin.fixes.util.CrossRegionEntityUtil.wakeUpAndDiscard(oldBobber);
+                oldBobber.kitinForceDiscard = true;
+                this.kitinForceDiscard = true;
+            } else {
+                KITIN_GLOBAL_BOBBERS.put(owner.getUUID(), this);
+            }
+        }
+        // Kitin end
         float xRot1 = player.getXRot();
         float yRot1 = player.getYRot();
         float yCos = Mth.cos(-yRot1 * Mth.DEG_TO_RAD - Mth.PI);
@@ -164,10 +183,24 @@ public class FishingHook extends Projectile {
 
     @Override
     public void tick() {
+        // Kitin start - FoliaFix_FishingHook
+        if (this.kitinForceDiscard) {
+            this.discard();
+            return;
+        }
+        // Kitin end
         this.syncronizedRandom.setSeed(this.getUUID().getLeastSignificantBits() ^ this.level().getGameTime());
         this.getInterpolation().interpolate();
         super.tick();
         Player owner = this.getPlayerOwner();
+        // Kitin start - FoliaFix_FishingHook
+        if (owner == null && this.kitinOwnerUUID != null) {
+            double simDistanceRadius = this.level().getServer().getPlayerList().getSimulationDistance() * 16.0D;
+            if (!this.level().hasNearbyAlivePlayer(this.getX(), this.getY(), this.getZ(), simDistanceRadius)) {
+                owner = me.sucixr.kitin.fixes.util.CrossRegionEntityUtil.getGlobalPlayer(this.level().getServer(), this.kitinOwnerUUID);
+            }
+        }
+        // Kitin end
         if (owner == null) {
             this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
         } else if (this.level().isClientSide() || !this.shouldStopFishing(owner)) {
@@ -272,7 +305,7 @@ public class FishingHook extends Projectile {
 
     private boolean shouldStopFishing(final Player owner) {
         // Folia start - region threading
-        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(owner)) {
+        if (!me.sucixr.kitin.fixes.util.CrossRegionEntityUtil.isPlayerCrossRegion(owner)) {
             return true;
         }
         // Folia end - region threading
@@ -613,6 +646,11 @@ public class FishingHook extends Projectile {
     public void remove(final Entity.RemovalReason reason, final org.bukkit.event.entity.EntityRemoveEvent.@Nullable Cause cause) { // CraftBukkit - add Bukkit remove cause
         //this.updateOwnerInfo(null); // Folia - region threading - move into preRemove
         super.remove(reason, cause); // CraftBukkit - add Bukkit remove cause
+        // Kitin start - FoliaFix_FishingHook
+        if (this.kitinOwnerUUID != null) {
+            KITIN_GLOBAL_BOBBERS.remove(this.kitinOwnerUUID, this);
+        }
+        // Kitin end
     }
 
     // Folia start - region threading
@@ -631,6 +669,11 @@ public class FishingHook extends Projectile {
     @Override
     public void setOwner(final @Nullable Entity owner) {
         super.setOwner(owner);
+        // Kitin start - FoliaFix_FishingHook
+        if (owner != null) {
+            this.kitinOwnerUUID = owner.getUUID();
+        }
+        // Kitin end
         this.updateOwnerInfo(this);
     }
 
