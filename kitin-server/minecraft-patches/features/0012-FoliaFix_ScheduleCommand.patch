+        try {
+        // Kitin end
+
         ++this.tickCount;
         // expire invalid click command callbacks
         io.papermc.paper.adventure.providers.ClickCallbackProviderImpl.ADVENTURE_CLICK_MANAGER.handleQueue((int)this.tickCount); // Paper // Folia - region threading - moved to global tick
@@ -342,6 +350,17 @@ public final class RegionizedServer {
         // commands
         ((DedicatedServer)MinecraftServer.getServer()).handleConsoleInputs();
 
+        //Kitin start - fix TimerQueue FoliaFix_ScheduleCommand use it
+        ServerLevel overworld = MinecraftServer.getServer().overworld();
+        if (overworld != null) {
+            overworld.serverLevelData.overworldData().getScheduledEvents().tick(MinecraftServer.getServer(), overworld.getGameTime());
+        }
+        //Kitin end
+
+        // Kitin start - FoliaFix_ScheduleCommand
+        MinecraftServer.getServer().getFunctions().tick();
+        // Kitin end
+
         // needs
         // player ping sample
         // world global tick
@@ -360,6 +379,11 @@ public final class RegionizedServer {
 
         // player list
         MinecraftServer.getServer().getPlayerList().tick();
+        // Kitin start - FoliaFix_ScheduleCommand
+        } finally {
+            IS_GLOBAL_TICKING = false;
+        }
+        // Kitin end
     }
 
     private void tickPlayerSample() {
diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
