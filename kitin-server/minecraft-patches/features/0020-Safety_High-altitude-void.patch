From: SucIXR <sasasa123456@foxmail.com>
Date: Fri, 24 Jul 2026 12:15:08 +0800
Subject: [PATCH] Safety_High-altitude-void


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index ec4d3f6cbf659090da515f6db89478e1aa1cd77b..7718e66318023b7a6b101a396bcb4bbd78960563 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -224,6 +224,7 @@ public abstract class Entity
     }
     // Paper end
     private static final Logger LOGGER = LogUtils.getLogger();
+    private static long lastHighAltitudeVoidLogTime = 0; // Kitin - High Altitude Void
     public static final String TAG_ID = "id";
     public static final String TAG_UUID = "UUID";
     public static final String TAG_PASSENGERS = "Passengers";
@@ -962,6 +963,30 @@ public abstract class Entity
 
     public void checkBelowWorld() {
         if (!this.level.getWorld().isVoidDamageEnabled()) return; // Paper - check if void damage is enabled on the world
+
+        // Kitin Start - High Altitude Void
+        if (me.sucixr.kitin.config.KitinConfig.highAltitudeVoidEnabled && this.getY() > (double) me.sucixr.kitin.config.KitinConfig.highAltitudeVoidHeight) {
+            if (this instanceof Player && !me.sucixr.kitin.config.KitinConfig.highAltitudeVoidDamagePlayers) {
+                return;
+            }
+            if (me.sucixr.kitin.config.KitinConfig.highAltitudeVoidLogWarnings) {
+                long now = System.currentTimeMillis();
+                if (now - lastHighAltitudeVoidLogTime >= 10000L) {
+                    lastHighAltitudeVoidLogTime = now;
+                    LOGGER.warn("[Kitin] {} moved too high, removed! World:{}[{},{},{}]",
+                            this.getEncodeId(),
+                            this.level.getWorld().getName(),
+                            String.format("%.2f", this.getX()),
+                            String.format("%.2f", this.getY()),
+                            String.format("%.2f", this.getZ())
+                    );
+                }
+            }
+            this.onBelowWorld();
+            return;
+        }
+        // Kitin end
+
         // Paper start - Configurable nether ceiling damage
         if (this.getY() < (this.level.getMinY() + this.level.getWorld().getVoidDamageMinBuildHeightOffset()) || (this.level.getWorld().getEnvironment() == org.bukkit.World.Environment.NETHER // Paper - use configured min build height offset
             && this.level.paperConfig().environment.netherCeilingVoidDamageHeight.test(v -> this.getY() >= v)
