From: SucIXR <sasasa123456@foxmail.com>
Date: Fri, 24 Jul 2026 10:55:23 +0800
Subject: [PATCH] FoliaFix_WaypointManager


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 35ab432bbd59aba80a6eaca1769e6aa82c8a7e46..1cd4ea0d7a95e919889f346e9a6919dedc87f505 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -684,7 +684,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
         this.sleepStatus = new SleepStatus();
         this.gameEventDispatcher = new GameEventDispatcher(this);
-        this.waypointManager = new ServerWaypointManager(this); // Paper - optimize ServerWaypointManager with locator bar disabled
+        this.waypointManager = new me.sucixr.kitin.fixes.foliafix.waypoint.KitinServerWaypointManager(this); // Paper - optimize ServerWaypointManager with locator bar disabled // Kitin WaypointManager
         this.environmentAttributes = EnvironmentAttributeSystem.builder().addDefaultLayers(this).build();
         //this.updateSkyBrightness(); // Folia - region threading - delay until first tick
         // Paper start - rewrite chunk system
diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 16f49ae6736c475207f31392307e280ec06edbc3..f5cf41a91fb11fd936f47207213786dac24ec382 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -877,6 +877,9 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
 
     @Override
     public void tick() {
+        // Kitin start
+        this.kitin$drainQueuedTasks();
+        // Kitin end
         // CraftBukkit start
         if (this.joining) {
             this.joining = false;
@@ -3646,5 +3649,37 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     public org.bukkit.craftbukkit.entity.CraftPlayer getBukkitEntity() {
         return (org.bukkit.craftbukkit.entity.CraftPlayer) super.getBukkitEntity();
     }
-    // CraftBukkit end
+    // CraftBukkit
+
+    // Kitin start - player mailbox for region-safe callbacks
+    private final java.util.concurrent.ConcurrentLinkedQueue<Runnable> kitin$queuedTasks =
+            new java.util.concurrent.ConcurrentLinkedQueue<>();
+
+    public void kitin$scheduleToOrRun(final Runnable task) {
+        // 只要当前线程就是这个 player 的 tick thread，就直接跑
+        if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)) {
+            task.run();
+            return;
+        }
+        // 否则丢进邮箱，等 player 自己 tick 时处理
+        this.kitin$queuedTasks.add(task);
+    }
+
+    private void kitin$drainQueuedTasks() {
+        // 防止恶意/意外塞爆：每 tick 限量执行
+        for (int i = 0; i < 1024; i++) {
+            final Runnable r = this.kitin$queuedTasks.poll();
+            if (r == null) {
+                return;
+            }
+            try {
+                r.run();
+            } catch (Throwable t) {
+                // 这里用你项目里现有的 logger 方式即可
+                // 不要用 MinecraftServer.getLogger()（你已经踩过那个坑）
+                com.mojang.logging.LogUtils.getLogger().error("[Kitin] queued task error", t);
+            }
+        }
+    }
+    // Kitin end
 }
