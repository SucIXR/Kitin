diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 7daeaa1915625b8c8a465996768552283763d1da..bf002fcdb27a579f622d2836f908fe9238505f4a 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -303,16 +303,54 @@ public final class RegionizedPlayerChunkLoader {
         return false;
     }
 
+    // Kitin start - QoS globalMaxChunkSendRate
+    private static final java.util.Comparator<ServerPlayer> URGENCY_COMPARATOR = (p1, p2) -> {
+        PlayerChunkLoaderData l1 = ((ChunkSystemServerPlayer) p1).moonrise$getChunkLoader();
+        PlayerChunkLoaderData l2 = ((ChunkSystemServerPlayer) p2).moonrise$getChunkLoader();
+
+        boolean empty1 = l1 == null || l1.sendQueue.isEmpty();
+        boolean empty2 = l2 == null || l2.sendQueue.isEmpty();
+        if (empty1 && empty2) return 0;
+        if (empty1) return 1;
+        if (empty2) return -1;
+
+        long key1 = l1.sendQueue.firstLong();
+        long key2 = l2.sendQueue.firstLong();
+
+        // 直接利用 Moonrise 的工具类计算曼哈顿距离
+        int dist1 = Math.abs(CoordinateUtils.getChunkX(key1) - l1.lastChunkX) + Math.abs(CoordinateUtils.getChunkZ(key1) - l1.lastChunkZ);
+        int dist2 = Math.abs(CoordinateUtils.getChunkX(key2) - l2.lastChunkX) + Math.abs(CoordinateUtils.getChunkZ(key2) - l2.lastChunkZ);
+
+        return Integer.compare(dist1, dist2);
+    };
+    // Kitin end
+
     public void tick() {
         TickThread.ensureTickThread("Cannot tick player chunk loader async");
         long currTime = System.nanoTime();
-        for (final ServerPlayer player : new java.util.ArrayList<>(this.world.getLocalPlayers())) { // Folia - region threding
+
+        // Kitin start - QoS globalMaxChunkSendRate
+        java.util.List<ServerPlayer> players = new java.util.ArrayList<>(this.world.getLocalPlayers()); // Folia - region threding
+
+        for (final ServerPlayer player : players) {
+            final PlayerChunkLoaderData loader = ((ChunkSystemServerPlayer)player).moonrise$getChunkLoader();
+            if (loader != null && !loader.removed && loader.world == this.world) { // can't invoke plugin logic
+                loader.update();
+            }
+        }
+
+        if (!players.isEmpty()) {
+            players.sort(URGENCY_COMPARATOR);
+        }
+        // Kitin end
+
+        for (final ServerPlayer player : players) { // Folia - region threding // Kitin - The code has been moved to the top
             final PlayerChunkLoaderData loader = ((ChunkSystemServerPlayer)player).moonrise$getChunkLoader();
             if (loader == null || loader.removed || loader.world != this.world) {
                 // not our problem anymore
                 continue;
             }
-            loader.update(); // can't invoke plugin logic
+            //loader.update(); // can't invoke plugin logic // Kitin - The code has been moved to the top
             loader.updateQueues(currTime);
         }
     }
@@ -847,6 +885,11 @@ public final class RegionizedPlayerChunkLoader {
             final long maxSendsThisTick = this.chunkSendLimiter.takeAllocation(maxSends);
             // we do not return sends that we took from the allocation back because we want to limit the max send rate, not target it
             for (long i = 0; i < maxSendsThisTick; ++i) {
+                // Kitin - QoS globalMaxChunkSendRate
+                if (!me.sucixr.kitin.network.qos.GlobalChunkLimiter.tryAcquire(this.player)) {
+                    break;
+                }
+                // Kitin end
                 final long pendingSend = this.sendQueue.firstLong();
                 final int pendingSendX = CoordinateUtils.getChunkX(pendingSend);
                 final int pendingSendZ = CoordinateUtils.getChunkZ(pendingSend);
