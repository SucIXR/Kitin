diff --git a/net/minecraft/world/entity/monster/piglin/Piglin.java b/net/minecraft/world/entity/monster/piglin/Piglin.java
index 3c99c69451b4b097e002747f99b4916106f44121..9b3f42d669d130e59c449be4044a69c087bdc937 100644
--- a/net/minecraft/world/entity/monster/piglin/Piglin.java
+++ b/net/minecraft/world/entity/monster/piglin/Piglin.java
@@ -326,6 +326,16 @@ public class Piglin extends AbstractPiglin implements CrossbowAttackMob, Invento
         PiglinAi.updateActivity(this);
         super.customServerAiStep(level);
     }
+    //Kitin Start
+    @Override
+    protected void pushEntities() {
+        // 只有当社交气泡/碰撞引擎允许时，才执行原版的推挤物理
+        // 这能极大减少由于挤压产生的微小坐标更新包
+        if (me.sucixr.kitin.scheduler.SocialBubbleEngine.getInstance().shouldProcessCollision(this)) {
+            super.pushEntities();
+        }
+    }
+    //Kitin end
 
