     // CraftBukkit end
@@ -295,10 +295,17 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         this.suspendFlushingOnServerThread = true;
     }
 
+    // Canvas start - optimize flush calls with region threading
