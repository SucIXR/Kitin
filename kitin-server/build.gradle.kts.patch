+// Kitin - Update Spark Version in SparksFly.java
+tasks.register("updateSparkVersion") {
+    val sparksFlyFile = layout.projectDirectory.dir("../paper-server/src/main/java/io/papermc/paper/SparksFly.java").asFile
+    val version = sparkVersion // Capture variable for configuration cache
+
+    inputs.property("sparkVersion", version)
+    outputs.file(sparksFlyFile)
+
+    doLast {
+        if (sparksFlyFile.exists()) {
+            val content = sparksFlyFile.readText()
+            val newContent = content.replace(
+                Regex("return \".*\"; // Kitin - Hardcoded version"),
+                "return \"$version-Kitin-Internal\"; // Kitin - Hardcoded version"
+            )
+            if (content != newContent) {
+                sparksFlyFile.writeText(newContent)
+                println("Updated Spark version in SparksFly.java to $version")
+            }
+        } else {
+            println("Warning: SparksFly.java not found at $sparksFlyFile")
+        }
+    }
+}
+
+tasks.named("compileJava") {
+    dependsOn("updateSparkVersion")
 }
