     private static final class PacketSendAction extends WrappedConsumer {
         private final Packet<?> packet;
+        // Kitin: 静态全局锁，防止日志雪崩卡死线程
+        private static volatile long lastSniper1LogTime = 0;
 
         private PacketSendAction(final Packet<?> packet, @Nullable final ChannelFutureListener channelFutureListener, final boolean flush) {
-            super(connection -> connection.sendPacket(packet, channelFutureListener, flush));
+            super(createConsumer(packet, channelFutureListener, flush, System.nanoTime()));
             this.packet = packet;
         }
+
+        private static Consumer<Connection> createConsumer(Packet<?> packet, @Nullable ChannelFutureListener listener, boolean flush, long enqueueTime) {
+            return connection -> {
+                long waitMs = (System.nanoTime() - enqueueTime) / 1_000_000L;
+                if (waitMs > 100) {
+                    long now = System.currentTimeMillis();
+                    // 核心限流：每 2 秒最多只打印一次警告
+                    if (now - lastSniper1LogTime > 2000) {
+                        lastSniper1LogTime = now;
+                        LOGGER.warn("🚨 [Kitin Sniper 1] Folia队列大堵塞! 耗时: {}ms | 样本包: {}", waitMs, packet.getClass().getSimpleName());
+                    }
+                }
+                connection.sendPacket(packet, listener, flush);
+            };
+        }
     }
     // Paper end - Optimize network
 }
