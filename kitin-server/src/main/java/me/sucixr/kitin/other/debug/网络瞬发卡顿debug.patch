+                            ids.append(value.id()).append(" ");
+                        }
+                    }
+                    LOGGER.warn("   🕵️ [Kitin Burst X-Ray] 堵塞在队列中的元数据 ID: [{}]", ids.toString().trim());
+                }
+                // --- Kitin Hook: 基于延迟触发的精准连抓 结束 ---
+
+                this.doSendPacket(packet, sendListener, flush);
+            });
         }
     }
 
