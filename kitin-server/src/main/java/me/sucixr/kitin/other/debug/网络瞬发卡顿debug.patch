     public <T> void set(EntityDataAccessor<T> key, T value, boolean force) {
+        // --- Kitin Hook: 临时物理切断 ID 10 (药水粒子) 的同步总闸 ---
+        if (key.id() == 10) {
+            return; // 直接拦截！不赋值，不标记 Dirty，绝对不引发广播发包！
+        }
+        // --- Kitin Hook 结束 ---
         SynchedEntityData.DataItem<T> item = this.getItem(key);
         if (force || ObjectUtils.notEqual(value, item.getValue())) {
             item.setValue(value);
             this.entity.onSyncedDataUpdated(key);
             item.setDirty(true);
             this.isDirty = true;
+
+            // --- Kitin Hook: 堆栈抓捕 开始 ---
+            if (key.id() == 10) {
+                long now = System.currentTimeMillis();
+                // 限流：每 5 秒只打印一次异常堆栈，防止卡服
+                if (now - kitin$lastId10TraceTime > 5000) {
+                    kitin$lastId10TraceTime = now;
+                    // 生成假异常以获取当前堆栈
+                    RuntimeException trace = new RuntimeException("Kitin Stack Trace Snipe");
+                    LOGGER.warn("🚨 [Kitin Truth] 捕获到元数据 ID [10] 被修改! 正在输出罪魁祸首的调用堆栈:", trace);
+                }
+            }
+            // --- Kitin Hook 结束 ---
         }
     }
 
